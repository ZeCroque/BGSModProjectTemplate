{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Papyrus Compile",
            "type": "process",
            "command": "{{game_path}}/{{compiler_path}}/PapyrusCompiler.exe",
            "args": 
            [
                {{debug_compile_args}}
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Papyrus Compile (Release)",
            "type": "process",
            "command": "{{game_path}}/{{compiler_path}}/PapyrusCompiler.exe",
            "args": 
            [
                {{release_compile_args}}
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
        {
            "label": "Package",
            "type": "process",
            "command": "py",
            "args": ["-3", "./build.py"],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}