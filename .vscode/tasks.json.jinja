{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Papyrus Compile",
            "type": "process",
            "command": "{{game_path}}/{{compiler_path}}/PapyrusCompiler.exe",
            "args": 
            [
                {{debug_compile_args}}
            ],
            "problemMatcher": {
                "owner": "external",
                "fileLocation": "absolute",
                "pattern": {
                  "regexp": "^(.*)\\((\\d+),(\\d+)\\):(.*)",
                  "file": 1,
                  "line": 2,
                  "column": 3,
                  "message": 4,
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Papyrus Compile (Release)",
            "type": "process",
            "command": "{{game_path}}/{{compiler_path}}/PapyrusCompiler.exe",
            "args": 
            [
                {{release_compile_args}}
            ],
            "problemMatcher": {
                "owner": "external",
                "fileLocation": "absolute",
                "pattern": {
                  "regexp": "^(.*)\\((\\d+),(\\d+)\\):(.*)",
                  "file": 1,
                  "line": 2,
                  "column": 3,
                  "message": 4,
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
        {
            "label": "Package",
            "type": "process",
            "command": "py",
            "args": ["-3", "./build.py"],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Format readme",
            "type": "process",
            "command": "py",
            "args": ["-3", "./CIScripts/readme_formatter.py"],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Add Strings to achlist",
            "type": "process",
            "command": "py",
            "args": ["-3", "./CIScripts/achlist.py"],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
        {{extra_tasks}}
    ]
}